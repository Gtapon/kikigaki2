      <div class="rh">答えを待っている質問</div><div class="rcard">${(S.meta.saved||[]).map((q,i)=>`<div style="display:flex;gap:6px;align-items:center"><span style="flex:1">${esc(q)}</span><button class="chip" data-unsave="${i}" aria-label="削除">✕</button></div>`).join("")||'<span class="c">なし</span>'}</div>`;
    return;
  }
  // stream / inbox: suggestion preview
  const sg=S.sugg&&S.sugg.list[S.suggIdx];
  let html=`<div class="rh">追記先のプレビュー</div>`;
  if(sg){
    const p=sg.p; const tail=(p.body||"").split(/\r?\n/).filter(l=>l.trim()).slice(-4).join("\n");
    html+=`<div class="rcard"><div class="c">${esc(p.category||"未分類")}</div><div class="t">${esc(p.title)}</div>${tail?`<div class="tail">${tail.split("\n").map(l=>inline(l)).join("\n")}</div>`:""}<div class="add">＋ ${inline(stampLine(autoLink($("#input").value.trim()),Date.now()))}</div></div>`;
  } else html+=`<div class="rnote">書いている内容に合うページが見つかると、ここに追記後の姿が出ます。</div>`;
  const recent=[]; S.entries.slice().sort((a,b)=>b.createdAt-a.createdAt).forEach(e=>{ if(e.target&&!recent.includes(e.target)&&recent.length<6) recent.push(e.target); });
  if(recent.length) html+=`<div class="rh" style="margin-top:8px">最近書き込んだページ</div><div class="chips">${recent.map(id=>pageById(id)).filter(Boolean).map(p=>`<button class="chip" data-target="${p.id}" title="入力中のメモをこのページに入れる">${esc(p.title)}</button>`).join("")}</div>`;
  const inbox=S.entries.filter(e=>!e.target).length;
  if(inbox) html+=`<div class="rcard" style="margin-top:8px"><div><b>整理待ちが ${inbox} 件</b></div><div class="c">手が空いたときに、候補のボタンを押すだけで振り分けられます。</div><div><button class="btn" data-act="inbox">整理待ちを見る</button></div></div>`;
  r.innerHTML=html;
}
