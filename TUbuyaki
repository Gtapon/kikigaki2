let impData=null;
$("#importBtn").onclick=()=>$("#file").click();
$("#file").onchange=async()=>{
  const f=$("#file").files[0]; $("#file").value=""; if(!f) return;
  try{
    const d=JSON.parse(await f.text());
    const pages=(d.pages||[]).filter(p=>p&&p.title).map(p=>({id:String(p.id||uid()),title:String(p.title),category:String(p.category||""),body:String(p.body||""),createdAt:+p.createdAt||Date.now(),updatedAt:+p.updatedAt||Date.now()}));
    const entries=(d.entries||[]).filter(e=>e&&e.text).map(e=>({id:String(e.id||uid()),text:String(e.text),createdAt:+e.createdAt||Date.now(),updatedAt:+e.updatedAt||Date.now(),target:e.target?String(e.target):null,appended:e.appended?String(e.appended):null}));
    if(!pages.length&&!entries.length) throw 0;
    impData={pages,entries,syn:typeof d.synonyms==="string"?d.synonyms:null,saved:Array.isArray(d.savedQuestions)?d.savedQuestions.map(String):[]};
    const sameIds=pages.filter(p=>pageById(p.id)).length, sameTitles=pages.filter(p=>!pageById(p.id)&&pageByTitle(p.title)).length;
    $("#impInfo").innerHTML=`ファイル：<b>${esc(f.name)}</b><br>ページ ${pages.length} 件・メモ ${entries.length} 件${d.exportedAt?`（${new Date(d.exportedAt).toLocaleString("ja-JP")} に書き出し）`:""}<br><br>
      <b>追加・更新する</b>：いまのデータは残したまま、新しいものを足します。同じページは<b>更新日が新しい方</b>を残します${sameTitles?`。名前だけ同じ別ページ ${sameTitles} 件は「（取り込み）」をつけて追加します`:""}。<br>
      <b>置き換える</b>：いまのデータを消して、ファイルの中身だけにします。`;
    $("#impDlg").showModal();
  }catch(e){ alert("読み込めませんでした。Streamで書き出したJSONファイルを選んでください。"); }
};
$("#impCancel").onclick=()=>{ impData=null; $("#impDlg").close(); };
$("#impReplace").onclick=async()=>{ if(!impData) return; if(!confirm("いまのデータをすべて消して置き換えます。よろしいですか？")) return; await dbClear(); S.pages=[];S.entries=[];S.meta={}; await doMerge(); };
$("#impMerge").onclick=()=>doMerge();
async function doMerge(){
  const d=impData; impData=null; $("#impDlg").close(); if(!d) return;
  let addP=0,updP=0,addE=0;
  for(const p of d.pages){
    const cur=pageById(p.id);
    if(cur){ if(p.updatedAt>cur.updatedAt){ Object.assign(cur,p); await dbPut("pages",cur); updP++; } continue; }
    if(pageByTitle(p.title)) p.title=p.title+"（取り込み）";
    S.pages.push(p); await dbPut("pages",p); addP++;
  }
  for(const e of d.entries){ if(S.entries.some(x=>x.id===e.id)) continue; S.entries.push(e); await dbPut("entries",e); addE++; }
  if(d.syn&&!S.meta.syn) await setMeta("syn",d.syn);
  if(d.saved.length) await setMeta("saved",[...new Set([...(S.meta.saved||[]),...d.saved])]);
  IX.dirty=true; render(); showToast(`ページ追加 ${addP}・更新 ${updP}・メモ追加 ${addE}`);
}

/* ---------------- 設定 ---------------- */
$("#settingsBtn").onclick=()=>{ $("#synText").value=S.meta.syn??DEFAULT_SYN; $("#setDlg").showModal(); };
$("#synSave").onclick=async()=>{ await setMeta("syn",$("#synText").value); readSyn(); $("#setDlg").close(); showToast("言い換え辞書を保存しました"); };
$("#sampleBtn").onclick=async()=>{ $("#setDlg").close(); await loadSample(); };
$("#wipeBtn").onclick=async()=>{ if(!confirm("すべてのページとメモを消します。元に戻せません。\n先に「書き出し」でバックアップをとりましたか？")) return; if(!confirm("本当に消しますか？")) return; await dbClear(); S.pages=[];S.entries=[];S.meta={}; IX.dirty=true; $("#setDlg").close(); S.view="stream"; render(); };

/* ---------------- 入力欄 ---------------- */
const ta=$("#input");
function autoSize(){ ta.style.height="auto"; ta.style.height=Math.min(220,ta.scrollHeight)+"px"; }
function debounce(fn,ms){ let t; return (...a)=>{ clearTimeout(t); t=setTimeout(()=>fn(...a),ms); }; }
const updateSugg=debounce(()=>{ const list=suggestFor(ta.value); const prev=S.sugg&&S.sugg.list[S.suggIdx]; S.sugg={list}; const keep=prev?list.findIndex(s=>s.p.id===prev.p.id):-1; S.suggIdx=keep>=0?keep:0; renderSugg(); },160);
ta.addEventListener("input",()=>{ autoSize(); updateSugg(); updateAC(); });
let ac={open:false,items:[],idx:0,start:0};
function updateAC(){
  const pos=ta.selectionStart, before=ta.value.slice(0,pos), m=before.match(/\[\[([^\]\n]*)$/);
  if(!m){ closeAC(); return; }
  const q=m[1].normalize("NFKC").toLowerCase();
  const items=S.pages.filter(p=>p.title.normalize("NFKC").toLowerCase().includes(q)).slice(0,8);
  ac={open:true,items,idx:0,start:pos-m[1].length,q:m[1]};
  const el=$("#ac"); el.hidden=false;
  el.innerHTML=items.map((p,i)=>`<button type="button" class="${i===0?"on":""}" data-ac="${i}">${esc(p.title)}<span class="cat2">${esc(p.category||"")}</span></button>`).join("")+(m[1].trim()?`<button type="button" data-ac="new" class="${items.length?"":"on"}">＋「${esc(m[1])}」というページをリンク（あとで作れます）</button>`:"");
  if(!items.length&&!m[1].trim()) closeAC();
}
function closeAC(){ ac.open=false; $("#ac").hidden=true; }
function pickAC(i){
  const title= i==="new" ? ac.q.trim() : ac.items[i]?.title; if(!title){ closeAC(); return; }
  const v=ta.value, pos=ta.selectionStart; const after=v.slice(pos).replace(/^\]\]/,"");
  ta.value=v.slice(0,ac.start)+title+"]]"+after; const np=ac.start+title.length+2; ta.setSelectionRange(np,np); closeAC(); ta.focus(); updateSugg();
}
$("#ac").addEventListener("mousedown",e=>{ const b=e.target.closest("[data-ac]"); if(b){ e.preventDefault(); pickAC(b.dataset.ac==="new"?"new":+b.dataset.ac); } });
ta.addEventListener("keydown",e=>{
  if(e.isComposing||e.keyCode===229) return;   // 日本語入力の変換中は無視
  if(ac.open){
    const btns=[...$("#ac").querySelectorAll("button")];
    if(e.key==="ArrowDown"||e.key==="ArrowUp"){ e.preventDefault(); ac.idx=(ac.idx+(e.key==="ArrowDown"?1:-1)+btns.length)%btns.length; btns.forEach((b,i)=>b.classList.toggle("on",i===ac.idx)); return; }
    if(e.key==="Enter"||e.key==="Tab"){ e.preventDefault(); const b=btns[ac.idx]; if(b) pickAC(b.dataset.ac==="new"?"new":+b.dataset.ac); return; }
    if(e.key==="Escape"){ e.preventDefault(); closeAC(); return; }
  }
  if(e.key==="Tab"&&S.sugg&&S.sugg.list.length>1){ e.preventDefault(); S.suggIdx=(S.suggIdx+(e.shiftKey?-1:1)+S.sugg.list.length)%S.sugg.list.length; renderSugg(); return; }
  if(e.key==="Enter"&&(e.ctrlKey||e.metaKey)){ e.preventDefault(); post("later"); return; }
  if(e.key==="Enter"&&!e.shiftKey){ e.preventDefault(); post("auto"); return; }
  if(e.key==="Escape"&&S.sugg){ S.sugg=null; renderSugg(); }
});

/* ---------------- クリックの受け口 ---------------- */
document.addEventListener("click",async e=>{
  const t=e.target.closest("button,select"); if(!t) return;
  const d=t.dataset;
  if(d.view){ S.view=d.view; S.pageId=null; render(); if(d.view!=="sitemap") scrollBottom(); return; }
  if(d.cat!==undefined&&t.classList.contains("cat")){ S.openCats.has(d.cat)?S.openCats.delete(d.cat):S.openCats.add(d.cat); renderLeft(); return; }
  if(d.page){ openPage(d.page); return; }
  if(d.goto!==undefined&&t.classList.contains("link")||d.goto!==undefined&&t.classList.contains("chip")){ const p=pageByTitle(d.goto); if(p) openPage(p.id); else openNewPage({title:d.goto}); return; }
  if(d.toggle){ toggleTodo(d.toggle); return; }
  if(d.file){ const en=S.entries.find(x=>x.id===d.file), p=pageById(d.to); if(en&&p){ await fileEntry(en,p); render(); } return; }
  if(d.newfrom){ const en=S.entries.find(x=>x.id===d.newfrom); if(en) openNewPage({fromEntry:en}); return; }
  if(d.unfile){ const en=S.entries.find(x=>x.id===d.unfile); if(en){ await unfile(en); render(); showToast("振り分けを取り消して、整理待ちに戻しました"); } return; }
  if(d.delete){ const en=S.entries.find(x=>x.id===d.delete); if(!en) return; if(!confirm("このメモを削除しますか？"+(en.target?"\n追記先のページからも取り除きます。":""))) return; if(en.target) await unfile(en); S.entries=S.entries.filter(x=>x.id!==en.id); await dbDel("entries",en.id); IX.dirty=true; render(); return; }
  if(d.edit){ const en=S.entries.find(x=>x.id===d.edit); if(!en) return; const nt=prompt("メモを編集",en.text); if(nt===null||!nt.trim()||nt===en.text) return; const linked=autoLink(nt);
    if(en.target){ const p=pageById(en.target); const na=stampLine(linked,en.createdAt); if(p&&en.appended&&p.body.includes(en.appended)){ p.body=p.body.split(en.appended).join(na); p.updatedAt=Date.now(); await dbPut("pages",p);} en.appended=na; }
    en.text=linked; en.updatedAt=Date.now(); IX.dirty=true; await dbPut("entries",en); render(); return; }
  if(d.sidx){ S.suggIdx=+d.sidx; renderSugg(); ta.focus(); return; }
  if(d.target){ const p=pageById(d.target); if(p&&ta.value.trim()) post({page:p}); else if(p) openPage(p.id); return; }
  if(d.unsave!==undefined){ const l=S.meta.saved||[]; l.splice(+d.unsave,1); await setMeta("saved",l); renderRight(); return; }
  switch(d.act){
    case "postauto": post("auto"); break;
    case "postlater": post("later"); break;
    case "postnew": post("new"); break;
    case "newpage": openNewPage(); break;
    case "sample": loadSample(); break;
    case "back": S.view="stream"; S.pageId=null; render(); scrollBottom(); break;
    case "edit": S.editing=true; renderCenter(); break;
    case "done": S.editing=false; IX.dirty=true; render(); break;
    case "delpage": deletePage(pageById(S.pageId)); break;
    case "inbox": S.view="inbox"; render(); scrollBottom(); break;
  }
});
document.addEventListener("change",async e=>{
  const s=e.target.closest("[data-pick]"); if(!s||!s.value) return;
  const en=S.entries.find(x=>x.id===s.dataset.pick), p=pageById(s.value); if(en&&p){ await fileEntry(en,p); render(); }
});
$("#askOpen").onclick=openAsk;
$("#newPageBtn").onclick=()=>openNewPage();
document.addEventListener("keydown",e=>{
  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==="k"){ e.preventDefault(); openAsk(); }
});

/* ---------------- トースト ---------------- */
let toastT=null,toastUndo=null;
function showToast(text,undo){
  $("#toastText").textContent=text; toastUndo=undo||null; $("#toastBtn").hidden=!undo;
  $("#toast").classList.add("show"); clearTimeout(toastT); toastT=setTimeout(()=>$("#toast").classList.remove("show"),undo?6000:2600);
}
$("#toastBtn").onclick=async()=>{ const u=toastUndo; toastUndo=null; $("#toast").classList.remove("show"); if(u){ await u(); showToast("元に戻しました"); } };
function scrollBottom(){ const sc=$("#scroll"); requestAnimationFrame(()=>sc.scrollTop=sc.scrollHeight); }
function flashEntry(id){ requestAnimationFrame(()=>{ const el=document.getElementById("en-"+id); if(el){ el.classList.remove("flash"); void el.offsetWidth; el.classList.add("flash"); } }); }

/* ---------------- サンプル ---------------- */
const DEFAULT_SYN=`交通費=旅費=電車代=タクシー代=移動費
有給休暇=有給=有休=年休=休暇
在宅勤務=テレワーク=リモートワーク=在宅
パスワード=パスワ=pw=ログインできない
vpn=社外接続=リモート接続
締め日=締切=締め切り=期限=しめきり
請求書=インボイス
備品=文房具=消耗品=事務用品
欠勤=休む=休み
パソコン=pc
担当=窓口=担当者
連絡=電話=内線
予約=取る=押さえる
申請=頼む=依頼`;
async function loadSample(){
  if(S.pages.length&&!confirm("サンプルのページとメモを追加します（いまのデータは消えません）。よろしいですか？")) return;
  const now=Date.now(), day=86400000;
  const P=[
   ["業務マニュアル","経費精算の手順","## 1. 領収書をそろえる\n日付・金額・宛名がそろっているか確認する。\n## 2. 申請フォームに入力\n経費システムに入力して、領収書の画像を添付する。\n交通費は [[交通費の上限ルール]] に注意する。\n3万円をこえる経費は、使う前に事前申請が必要。\n## 3. 上長の承認\n経費精算の締め日は毎週金曜日の17時。\nわからないことは経理の佐藤さん（内線 214）へ。"],
   ["業務マニュアル","交通費の上限ルール","交通費の上限は片道2,000円まで。\nこえる場合は事前に上長の許可をとる。\n定期券の区間は支給しない。\nタクシーは原則使わない。終電後や重い荷物があるときだけ例外。"],
   ["業務マニュアル","請求書の発行","請求書は毎月25日までに発行する。\nテンプレートは共有フォルダの「経理/請求書」にある。"],
   ["業務マニュアル","新人オンボーディング","## 最初の1週間\n初日は受付で入館証を受け取る。\n初月のうちに [[経費精算の手順]] を読んでおく。\n## メンター\n今期のメンター担当は田中さん。"],
   ["人事・休暇","有給休暇の申請方法","有給休暇は勤怠システムから申請する。\n申請は取得日の3日前まで。急な体調不良は当日の朝でもよい。\n半日単位でも取れる。"],
   ["人事・休暇","在宅勤務のルール","在宅勤務は週2日まで。\n前日の17時までに上長に伝える。"],
   ["IT・パソコン","VPNがつながらないとき","まずパソコンを再起動して、もう一度接続する。\nそれでもつながらないときは情報システム部（内線 300）に連絡する。"],
   ["顧客","ミナト商事","担当者は田中さん。\n連絡は月曜の午前中がつかまりやすい。"],
   ["顧客","北斗物流","配送の相談窓口は中村さん。\n集荷の締め切りは平日の15時。"],
   ["議事録","9/24 定例","## 決まったこと\n展示会のブース案は来週までに2案にしぼる。"],
   ["プロジェクト","新システム移行","新しい業務システムへの移行を11月末までに完了する。\n操作の説明会は11月5日と11月12日。"],
  ];
  const ids={};
  for(const [c,t,b] of P){ if(pageByTitle(t)) continue; const p={id:uid(),title:t,category:c,body:b,createdAt:now-30*day,updatedAt:now-(5+Math.random()*20)*day}; ids[t]=p; S.pages.push(p); await dbPut("pages",p); }
  IX.dirty=true;
  const E=[
    [3*day+2*3600e3,"9/24定例で、経費精算の手順の締め日を金曜→木曜に変更と決まった","経費精算の手順"],
    [2*day+5*3600e3,"ミナト商事の担当が田中さんから木村さんに交代。連絡は月曜午前が確実","ミナト商事"],
    [1*day+3*3600e3,"在宅勤務のときは、始業時にチャットで「開始します」と一言入れる","在宅勤務のルール"],
    [5*3600e3,"□ 新システムのアカウント申請を今週中に\n□ 展示会のブース案を部長に確認",null],
    [2*3600e3,"会議室のプロジェクターは総務の棚にある。使ったら必ず戻す",null],
  ];
  for(const [ago_,text,to] of E){
    const e={id:uid(),text:autoLink(text),createdAt:now-ago_,updatedAt:now-ago_,target:null,appended:null};
    S.entries.push(e); await dbPut("entries",e);
    if(to&&pageByTitle(to)) await fileEntry(e,pageByTitle(to),{toast:false});
  }
  ["業務マニュアル","顧客"].forEach(c=>S.openCats.add(c));
  S.view="stream"; render(); scrollBottom(); showToast("サンプルを追加しました。下の欄に何か書いてみてください");
}

/* ---------------- 起動 ---------------- */
(async()=>{
  await dbOpen();
  S.pages=await dbAll("pages"); S.entries=await dbAll("entries");
  (await dbAll("meta")).forEach(m=>S.meta[m.k]=m.v);
  readSyn();
  if(navigator.storage&&navigator.storage.persist){ try{ navigator.storage.persist(); }catch(e){} }
  render(); scrollBottom(); ta.focus();
  setInterval(()=>{ if(S.view==="stream") renderLeft(); },60000);
})();
</script>
