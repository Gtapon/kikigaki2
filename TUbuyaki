  download(name,{app:"stream-kb",version:1,exportedAt:new Date().toISOString(),pages:S.pages,entries:S.entries.map(({appended,...e})=>({...e,appended})),synonyms:S.meta.syn??DEFAULT_SYN,savedQuestions:S.meta.saved||[]});
