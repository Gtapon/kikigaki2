  const inbox=S.view==="inbox";
  head.innerHTML=`<h1>${inbox?"整理待ち":"ストリーム"}</h1><span class="sub">${inbox?"まだどのページにも入っていないメモ":"書いたものが時系列に流れます"}</span><span class="sp"></span><span class="save" id="saveState">${saveState()}</span>`;
  const list=S.entries.filter(e=>!inbox||!e.target).sort((a,b)=>a.createdAt-b.createdAt);
  if(!list.length){
    sc.innerHTML= inbox? `<div class="welcome"><h2>整理待ちはありません</h2>すべてのメモがどこかのページに入っています。</div>` :
      `<div class="welcome"><h2>Streamへようこそ</h2>下の入力欄に、思いついたことや決まったことを<b>そのまま</b>書いてください。<br>すでにあるページ名が入っていれば、そのページに自動で追記されます。<br>どこに入れるか迷うメモは「整理待ち」に入り、あとで振り分けられます。<div class="row"><button class="btn primary" data-act="newpage">最初のページを作る</button><button class="btn" data-act="sample">サンプルで試す</button></div></div>`;
    return;
  }
  let html="",lastDay="";
  for(const e of list){
    const dk=dkey(e.createdAt); if(dk!==lastDay){ html+=`<div class="day">${dayLabel(e.createdAt)}</div>`; lastDay=dk; }
    const tp=e.target?pageById(e.target):null;
