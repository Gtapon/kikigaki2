}
$("#pageForm").onsubmit=async ev=>{
  ev.preventDefault();
  const title=$("#npTitle").value.trim(); if(!title) return;
  if(pageByTitle(title)){ alert("同じ名前のページがすでにあります。"); return; }
  const p={id:uid(),title,category:$("#npCat").value.trim(),body:"",createdAt:Date.now(),updatedAt:Date.now()};
  S.pages.push(p); IX.dirty=true; await dbPut("pages",p);
  S.openCats.add(p.category||"未分類");
  $("#pageDlg").close();
  if(pendingNew){ const e=pendingNew; pendingNew=null; e.text=autoLink(e.text); await fileEntry(e,p,{toast:false}); showToast(`ページ「${title}」を作って追記しました`); render(); }
  else openPage(p.id);
  // 既存メモ内の同名テキストをリンク化
  let changed=0; for(const e of S.entries){ const nt=autoLink(e.text); if(nt!==e.text){ e.text=nt; changed++; await dbPut("entries",e); } }
  if(changed) render();
};
$("#npCancel").onclick=()=>{ $("#pageDlg").close(); if(pendingNew){ pendingNew=null; render(); } };
async function renamePage(p,nt){
  if(!nt||nt===p.title) { $("#ptitle").value=p.title; return; }
  if(pageByTitle(nt)){ alert("同じ名前のページがすでにあります。"); $("#ptitle").value=p.title; return; }
  const old=p.title; const from="[["+old+"]]", to="[["+nt+"]]";
  p.title=nt; p.updatedAt=Date.now(); await dbPut("pages",p);
  for(const q of S.pages) if(q.body&&q.body.includes(from)){ q.body=q.body.split(from).join(to); await dbPut("pages",q); }
  for(const e of S.entries) if(e.text.includes(from)){ e.text=e.text.split(from).join(to); if(e.appended) e.appended=e.appended.split(from).join(to); await dbPut("entries",e); }
  IX.dirty=true; showToast(`「${old}」→「${nt}」に変更し、リンクも書きかえました`); render();
}
async function deletePage(p){
  const n=S.entries.filter(e=>e.target===p.id).length;
  if(!confirm(`ページ「${p.title}」を削除しますか？${n?`\nこのページに振り分けたメモ ${n} 件は「整理待ち」に戻ります。`:""}`)) return;
  for(const e of S.entries) if(e.target===p.id){ e.target=null; e.appended=null; await dbPut("entries",e); }
  S.pages=S.pages.filter(x=>x.id!==p.id); await dbDel("pages",p.id); IX.dirty=true;
  S.view="stream"; S.pageId=null; render();
}
async function toggleTodo(ctx){
  const [kind,id,li]=ctx.split(":");
  const sw=l=>/^\s*(☑|\[x\])/i.test(l)? l.replace(/^(\s*)(☑|\[x\])/i,"$1□") : l.replace(/^(\s*)(□|☐|\[ \])/,"$1☑");
  if(kind==="p"){ const p=pageById(id); const ls=p.body.split(/\r?\n/); ls[+li]=sw(ls[+li]); p.body=ls.join("\n"); p.updatedAt=Date.now(); await dbPut("pages",p); }
  else { const e=S.entries.find(x=>x.id===id); const ls=e.text.split(/\r?\n/); const before=ls[+li]; ls[+li]=sw(ls[+li]); e.text=ls.join("\n");
    const p=e.target&&pageById(e.target);
    if(p&&e.appended){ const na=e.appended.split(before).join(ls[+li]); if(p.body.includes(e.appended)){ p.body=p.body.split(e.appended).join(na); await dbPut("pages",p);} e.appended=na; }
    await dbPut("entries",e); }
  IX.dirty=true; render();
}

/* ---------------- 聞く ---------------- */
function openAsk(){ $("#askDlg").showModal(); $("#askQ").select(); if(!$("#askQ").value) $("#askRes").innerHTML=askIntro(); }
function askIntro(){ return `<div class="rnote">ページと整理待ちのメモの中から、答えになりそうな一文を探します。<br>例：「交通費っていくらまで？」「経費の締め日はいつ？」「〇〇の担当は誰？」</div>${(S.meta.saved||[]).length?`<div class="rnote"><b>答えを待っている質問：</b>${S.meta.saved.map(esc).join("、")}</div>`:""}`; }
function srcLabel(c){ if(c.kind==="entry"){ const e=S.entries.find(x=>x.id===c.eid); return `整理待ちのメモ（${e?dayLabel(e.createdAt):""}）`; } const p=pageById(c.pid); return `${esc(p?.title||"")}（${esc(p?.category||"未分類")}）`; }
function ask(q){
  q=q.trim(); const box=$("#askRes"); if(!q){ box.innerHTML=askIntro(); return; }
  const {Q,res}=search(q,{kinds:["page","entry"]});
  let best=res[0];
  // 同じページに「あとから追記された文」で十分近いものがあれば、新しい情報としてそちらを答えにする
  if(best&&best.c.pid&&!/〔[0-9]+\/[0-9]+〕\s*$/.test(best.c.line)){
    const newer=res.find(r=>r!==best&&r.c.pid===best.c.pid&&r.c.kind==="page"&&/〔[0-9]+\/[0-9]+〕\s*$/.test(r.c.line)&&r.cov>=0.5&&r.s>=best.s*0.55);
    if(newer){ res.splice(res.indexOf(newer),1); res.unshift(newer); best=newer; best.newer=true; }
  }
  if(!best||best.cov<0.28){
    box.innerHTML=`<div class="ans" style="border-color:var(--line)"><span class="conf l" style="align-self:flex-start">見つかりませんでした</span><div>「${esc(q)}」に答えられそうな文が、まだありません。</div>
      <div class="chips"><button class="btn primary" data-saveq="${esc(q)}">この質問を保存しておく</button><button class="btn" data-qpost="${esc(q)}">ストリームに質問として書く</button></div></div>`;
    return;
  }
  const cf=best.cov>=0.6?["高","h"]:best.cov>=0.4?["中","m"]:["低","l"];
  const seen=new Set([best.c.pid||best.c.eid]); const others=[];
  for(const r of res.slice(1)){ if(others.length>=4) break; const k=r.c.pid||r.c.eid; if(seen.has(k)||r.cov<0.25) continue; seen.add(k); others.push(r); }
  const words=matchedWords(best.c.line,best.hit);
  const same=best.c.pid? res.filter(r=>r!==best&&r.c.pid===best.c.pid&&r.c.kind==="page"&&r.cov>=0.5).slice(0,2):[];
  box.innerHTML=`<div class="ans"><div class="chips"><span class="conf ${cf[1]}">答えはたぶんここ ・ 自信度 ${cf[0]}</span><button class="link" data-open="${best.c.kind}:${best.c.pid||best.c.eid}:${best.c.li}">${srcLabel(best.c)}</button></div>
    <div class="big">${highlight(best.c.line,best.hit)}</div>
    ${best.newer?`<div class="rnote">あとから追記された新しい情報を優先して表示しています。元の記述は下の「同じページの関連する文」にあります。</div>`:""}
    <div class="why"><div>一致した言葉：${words.map(esc).join("、")||"ページ名・見出し"}</div>${Q.types.length?`<div>質問の種類：${Q.types.map(t=>t.label).join("・")} → ${best.typeHit.length?"合う文を優先しました":"合う文はありませんでした"}</div>`:""}${Q.expansions.length?`<div>言い換えも探しました：${Q.expansions.slice(0,5).map(esc).join("、")}</div>`:""}</div></div>
    ${same.length?`<div class="rh">同じページの関連する文（新しい情報がないか確認を）</div>${same.map(r=>`<button class="cand" data-open="page:${r.c.pid}:${r.c.li}"><span class="s">${highlight(r.c.line,r.hit)}</span></button>`).join("")}`:""}
    ${others.length?`<div class="rh">ほかの候補</div>${others.map(r=>`<button class="cand" data-open="${r.c.kind}:${r.c.pid||r.c.eid}:${r.c.li}"><b>${srcLabel(r.c)}</b><span class="s">${highlight(r.c.line,r.hit)}</span></button>`).join("")}`:""}`;
}
$("#askForm").onsubmit=e=>{ e.preventDefault(); ask($("#askQ").value); };
$("#askRes").addEventListener("click",async e=>{
  const o=e.target.closest("[data-open]");
  if(o){ const [kind,id,li]=o.dataset.open.split(":"); $("#askDlg").close();
