    let chips="";
    if(tp){
      const others=mentionedPages(e.text).filter(p=>p.id!==tp.id);
      chips=`<div class="chips"><button class="chip done" data-page="${tp.id}">→ ${esc(tp.title)} に追記済み</button>${others.map(p=>`<button class="chip" data-page="${p.id}">${esc(p.title)} にも表示</button>`).join("")}</div>`;
    }else{
      const sg=suggestFor(e.text);
      chips=`<div class="chips"><span class="chip inbox">整理待ち</span>${sg.map(s=>`<button class="chip" data-file="${e.id}" data-to="${s.p.id}" title="${esc(s.why)}">→ ${esc(s.p.title)}</button>`).join("")}
        <select data-pick="${e.id}" aria-label="追記先を選ぶ"><option value="">ページを選ぶ…</option>${cats().map(([c,ps])=>`<optgroup label="${esc(c)}">${ps.map(p=>`<option value="${p.id}">${esc(p.title)}</option>`).join("")}</optgroup>`).join("")}</select>
        <button class="chip ghost" data-newfrom="${e.id}">＋ 新しいページにする</button></div>`;
    }
    html+=`<div class="entry" id="en-${e.id}"><div class="tm">${hm(e.createdAt)}</div><div class="bd"><div class="tx">${text}</div>${chips}</div>
      <div class="acts">${tp?`<button data-unfile="${e.id}">振り分けを取り消す</button>`:""}<button data-edit="${e.id}">編集</button><button data-delete="${e.id}">削除</button></div></div>`;
  }
  sc.innerHTML=html;
}
function renderPage(head,sc){
  const p=pageById(S.pageId); if(!p){ S.view="stream"; return render(); }
  head.innerHTML=`<button class="btn" data-act="back">← ストリーム</button><span class="sub">${esc(p.category||"未分類")}</span><span class="sp"></span><span class="save" id="saveState">${saveState()}</span>
    ${S.editing?`<button class="btn primary" data-act="done">編集を終える</button>`:`<button class="btn" data-act="edit">編集</button>`}<button class="btn danger" data-act="delpage">削除</button>`;
  const lines=(p.body||"").split(/\r?\n/);
