/* ---------------- ページ操作 ---------------- */
function openPage(id,hitLine=-1){ S.view="page"; S.pageId=id; S.hitLine=hitLine; S.editing=false; render(); }
let pendingNew=null;
function openNewPage({title="",category="",fromEntry=null}={}){
  pendingNew=fromEntry;
  $("#npTitle").value=title|| (fromEntry? fromEntry.text.replace(/\[\[|\]\]/g,"").split(/\r?\n/)[0].replace(/[。．.、,].*$/,"").slice(0,30):"");
  let cat=category;
  if(!cat&&fromEntry){ const {res}=search(fromEntry.text,{kinds:["page"]}); const top=res.find(r=>r.cov>=0.3); if(top) cat=pageById(top.c.pid)?.category||""; }
  $("#npCat").value=cat;
  $("#npNote").textContent=fromEntry?"いまのメモがこのページの最初の内容になります。":"";
  $("#catList").innerHTML=cats().map(([c])=>`<option value="${esc(c)}">`).join("");
