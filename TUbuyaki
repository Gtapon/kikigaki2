      (open?ps.slice().sort((a,b)=>a.title.localeCompare(b.title,"ja")).map(p=>`<button class="pg${p.id===S.pageId&&S.view==="page"?" cur":""}" data-page="${p.id}" title="${esc(p.title)}">${esc(p.title)}</button>`).join(""):"");
  }).join("")||`<div class="rnote" style="padding:4px 12px">まだページがありません</div>`;
